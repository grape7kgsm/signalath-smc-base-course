# YouTube Data API v3 (最新動画パフォーマンス分析用)
# Google Cloud Console で「YouTube Data API v3」を有効化し、API キーを発行。
YOUTUBE_API_KEY=
# 分析対象チャンネル。"UC..." のチャンネルID か "@signalath" のハンドル。
YOUTUBE_CHANNEL_ID=

# YouTube Analytics API (OAuth2 / 視聴維持率など。任意)
# Google Cloud で「YouTube Analytics API」を有効化し、OAuth クライアント
# (アプリの種類: デスクトップ) を作成して下記を設定。
# その後 `npm run yt:login` を実行すると REFRESH_TOKEN が
# .env.youtube.local に自動保存される（.env.youtube.local は gitignore 済み）。
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# 下記は npm run yt:login が自動生成。手動設定は不要。
YOUTUBE_OAUTH_REFRESH_TOKEN=

# 既存の連携（参考）
NOTION_API_KEY=
NOTION_APPLY_DB_ID=
DISCORD_APPLY_WEBHOOK_URL=
